# LLM 网关(OpenAI 兼容协议;开发期指向国内公有云 API,私有化指向 vLLM)
LLM_API_KEY=demo-key-replace-me
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 数据库(docker compose 起的本项目独立 PG+pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/penalties

# 运行环境 profile: dev(允许 crawler)/ prod(禁止 crawler,架构红线第 4 条)
APP_PROFILE=dev
